{
  "name": "leanwise-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "tsx --test tests/*.test.ts && node --test server/backend.test.js && node --test miniprogram/tests/*.test.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "recharts": "^3.0.0",
    "express": "^5.1.0",
    "openai": "^6.0.0",
    "dotenv": "^17.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.9.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0"
  }
}
